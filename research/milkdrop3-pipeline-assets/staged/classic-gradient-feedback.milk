MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1.0
fGammaAdj=1.0
fWaveAlpha=0.0
fVideoEchoAlpha=0.0
bMotionVectorsOn=0
ob_size=0.0
ib_size=0.0
zoom=1.0
zoomexp=1.0
rot=0.0
warp=0.0
cx=0.5
cy=0.5
dx=0.0
dy=0.0
sx=1.0
sy=1.0
per_frame_init_1=framecounter=0;
per_frame_1=framecounter=framecounter+1; q1=framecounter; zoom=1;rot=0;warp=0;dx=0;dy=0;
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D(sampler_main,uv).xyz*0.8 + float3(uv.x*0.2,uv.y*0.2,0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret = tex2D(sampler_main,uv).xyz*0.5 + float3(0,0,saturate(q1/255.0));
comp_4=`}
