blending_pattern=zoom
blending_progress=0.5
blending_direction=1
random_1=0.2
random_2=0.4
random_3=0.6
random_4=0.8
random_5=0.5
[PRESET1_BEGIN]
NAME=Hex reference mask red
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1.0
fGammaAdj=1.0
fWaveAlpha=0.0
fVideoEchoAlpha=0.0
bMotionVectorsOn=0
ob_size=0.0
ib_size=0.0
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D(sampler_main, uv).xyz;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret=float3(q1,0,0);
comp_4=`}
per_frame_1=long_name=0.25; q1=long_
per_frame_2=name;
[PRESET1_END]
[PRESET2_BEGIN]
NAME=Hex reference mask red
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1.0
fGammaAdj=1.0
fWaveAlpha=0.0
fVideoEchoAlpha=0.0
bMotionVectorsOn=0
ob_size=0.0
ib_size=0.0
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D(sampler_main, uv).xyz;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret=float3(q1,0,0);
comp_4=`}
per_frame_1=long_name=0.25; q1=long_
per_frame_2=name;
[PRESET2_END]
