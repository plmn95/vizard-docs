blending_pattern=cercle
blending_progress=0.5
blending_direction=1
random_1=0.2
random_2=0.4
random_3=0.6
random_4=0.8
random_5=0.5
[PRESET1_BEGIN]
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1
fGammaAdj=1
fWaveAlpha=0
fVideoEchoAlpha=0
bMotionVectorsOn=0
ob_size=0
ib_size=0
zoom=1
zoomexp=1
rot=0
warp=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
blur1_min=0
blur1_max=1
blur2_min=0
blur2_max=1
blur3_min=0
blur3_max=1
blur1_edge_darken=0
per_frame_init_1=framecounter=0;
per_frame_1=framecounter=framecounter+1; q1=framecounter; q2=framecounter-2*int(framecounter/2);
warp_1=`shader_body
warp_2=`{
warp_3=`ret=float3(q2,0,0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret=float3(0,0,0);
comp_4=`}
[PRESET1_END]
[PRESET2_BEGIN]
MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1
fGammaAdj=1
fWaveAlpha=0
fVideoEchoAlpha=0
bMotionVectorsOn=0
ob_size=0
ib_size=0
zoom=1
zoomexp=1
rot=0
warp=0
cx=0.5
cy=0.5
dx=0
dy=0
sx=1
sy=1
blur1_min=0
blur1_max=1
blur2_min=0
blur2_max=1
blur3_min=0
blur3_max=1
blur1_edge_darken=0
per_frame_init_1=framecounter=0;
per_frame_1=framecounter=framecounter+1; q1=framecounter; q2=framecounter-2*int(framecounter/2);
warp_1=`shader_body
warp_2=`{
warp_3=`ret=float3(0,0,0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret=float3(tex2D(sampler_main,uv).r,GetBlur1(uv).r,0.2);
comp_4=`}
[PRESET2_END]
