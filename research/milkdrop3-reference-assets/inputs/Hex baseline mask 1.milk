MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fDecay=1.0
fGammaAdj=1.0
fWaveAlpha=0.0
fVideoEchoAlpha=0.0
bMotionVectorsOn=0
ob_size=0.0
ib_size=0.0
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D(sampler_main, uv).xyz;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret = float3(0,0,1);
comp_4=`}
