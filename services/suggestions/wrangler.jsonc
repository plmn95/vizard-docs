{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vizard-doc-suggestions",
  "account_id": "7fc903fb56dd4cee9cb98709f7ddc1c1",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "ENABLED": "true",
    "GITHUB_REPO": "plmn95/vizard-docs",
    "DOCS_URL": "https://plmn95.github.io/vizard-docs",
    "ALLOWED_ORIGINS": "https://plmn95.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vizard-doc-suggestions",
    "database_id": "67265e09-e509-4229-a718-d7455136c261",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
