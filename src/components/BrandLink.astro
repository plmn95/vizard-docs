---
import { assetWithBase, LOGO_PATH } from '../lib/brand-assets.mjs';

const { href, version } = Astro.props;
const logoHref = assetWithBase(import.meta.env.BASE_URL, LOGO_PATH);
---

<a href={href} class="vizard-brand" data-vizard-brand aria-label="Hex Composer Documentation home">
  <img src={logoHref} alt="Hex Composer" width="217" height="25" />
  <span>Documentation{version ? ` · ${version}` : ''}</span>
</a>

<style>
  .vizard-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    color: #e8e8ea;
    text-decoration: none;
    white-space: nowrap;
  }

  .vizard-brand img {
    width: 13.6rem;
    height: auto;
    flex: none;
  }

  .vizard-brand span {
    color: #8a8a90;
    font-size: 0.88rem;
    font-weight: 450;
  }

  @media (max-width: 28rem) {
    .vizard-brand span { display: none; }
  }
</style>
