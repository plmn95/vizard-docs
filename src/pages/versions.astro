---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// Frozen manuals retain their original /vizard-docs/releases/... base and host.
// GitHub Pages assembles its own chooser after the build; release builds stay offline.
let versions: string[] = [];
if (process.env.VERCEL === '1' && !process.env.VIZARD_DOCS_VERSION) {
  const response = await fetch('https://api.github.com/repos/plmn95/vizard-docs/releases?per_page=100', {
    headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'hexcomposer-docs-build' },
  });
  if (!response.ok) throw new Error(`Cannot load manual versions: ${response.status}`);
  const releases = await response.json();
  versions = releases.filter((release) => !release.draft && /^v\d+\.\d+\.\d+(?:-[A-Za-z0-9.-]+)?$/.test(release.tag_name)
    && ['manual.zip', 'manual.zip.json'].every((name) => release.assets.some((asset) => asset.name === name)))
    .map((release) => release.tag_name);
}
---
<StarlightPage frontmatter={{ title: 'Documentation versions', description: 'Read current Hex Composer documentation or open the frozen manual shipped with an earlier release.', editUrl: false, sidebar: { hidden: true } }}>
  <p>Each release keeps the manual and appearance shipped with the app.</p>
  <ul>
    <li><a href="https://docs.hexcomposer.com/">Current documentation</a></li>
    {versions.map((version) => <li><a href={`https://plmn95.github.io/vizard-docs/releases/${version}/`}>Hex Composer {version}</a></li>)}
  </ul>
</StarlightPage>
