---
import { readFileSync, readdirSync } from 'node:fs';
import { api, siteKey, enabled, revision } from '../../lib/suggestions/config.mjs';
import { splitDocument } from '../../lib/suggestions/document.mjs';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '../../styles/editor.css';
export function getStaticPaths() {
  if (!enabled) return [];
  return readdirSync('src/content/docs', { recursive: true }).filter(file => String(file).endsWith('.md')).map(file => {
    const source = readFileSync(`src/content/docs/${file}`, 'utf8');
    const { body } = splitDocument(source);
    const titleLine = source.match(/^title:\s*(.+)$/m)?.[1] ?? String(file);
    const title = titleLine.startsWith('"') ? JSON.parse(titleLine) : titleLine.replace(/^'|'$/g, '');
    return { params: { page: String(file).replace(/\.md$/, '') }, props: { body, title, path: `src/content/docs/${file}`, file: String(file) } };
  });
}
const { body, title, path, file } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = file.replace(/(?:\/index)?\.md$/, '').replace(/^index$/, '');
const returnUrl = `${base}/${route ? route + '/' : ''}`;
const data = JSON.stringify({ body, title, path, revision, api, siteKey, returnUrl, receipt: `${base}/suggestion/` }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>Edit {title} | Vizard Documentation</title></head>
<body data-pagefind-ignore="all">
  <header class="edit-header"><a href={`${base}/`} class="brand" aria-label="Vizard Documentation home"><img src={`${base}/vizard-logo.svg`} alt="" width="32" height="26" /><strong translate="no">VIZARD</strong><span>Documentation</span></a><div class="actions"><a data-cancel href={returnUrl}>Cancel</a><button data-review class="primary" disabled>Review changes</button><button data-back hidden>Keep editing</button><button data-send class="primary" hidden>Send suggestion</button></div></header>
  <main>
    <div class="page-heading"><h1>{title}</h1><p data-intro>Edit the page. Your changes will be reviewed before publication.</p></div>
    <p data-draft-status class="draft-status" role="status">Loading editor…</p>
    <section data-edit><div data-editor></div></section>
    <section data-problem hidden><label for="problem">What is incorrect, unclear, or missing?</label><textarea id="problem" rows="8" maxlength="3000"></textarea></section>
    <section data-preview hidden tabindex="-1" aria-labelledby="review-title"><h2 id="review-title">Review your changes</h2><p class="muted" data-review-hint>Only changed sections are shown.</p><div data-diff></div><label for="explanation">Why this change? <span class="muted">(optional)</span></label><textarea id="explanation" rows="3" maxlength="3000"></textarea><p class="muted">Your suggestion will be public. Please leave out personal information.</p><div data-challenge></div></section>
    <p data-message role="status" class="message"></p>
    <section data-success hidden><h2>Thank you. Your suggestion is saved.</h2><p>You can check its progress using the link below.</p><a data-receipt>Check suggestion status</a><p><a href={returnUrl}>Back to the documentation</a></p></section>
    <footer data-editor-footer><span>No account needed. Suggestions are public.</span><a data-problem-link href="?mode=problem">Describe a problem instead</a><button data-discard hidden>Discard saved draft</button></footer>
    <noscript>Enable JavaScript to edit this page, or use the GitHub edit link on the documentation page.</noscript>
  </main>
  <script id="page-source" type="application/json" set:html={data} />
  <script>import '../../lib/suggestions/page-client';</script>
</body></html>
